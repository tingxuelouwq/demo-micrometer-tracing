<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.kevin</groupId>
    <artifactId>demo-dependencies</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>demo-dependencies</name>
    <packaging>pom</packaging>

    <properties>
        <!-- 框架版本号 -->
        <demo.version>0.0.1-SNAPSHOT</demo.version>

        <!-- 基础环境 -->
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Spring Cloud 版本（Boot Parent 不包含，需额外定义） -->
        <spring-cloud.version>2025.1.1</spring-cloud.version>

        <!-- 其他组件版本 -->
        <!-- 日志相关 -->
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 其他非 Spring 管理的依赖 -->
            <!-- Logstash Logback Encoder -->
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback-encoder.version}</version>
            </dependency>

            <!-- 框架 Starters (硬编码版本，避免子项目继承时 ${project.version} 解析错误) -->
            <dependency>
                <groupId>com.kevin</groupId>
                <artifactId>demo-microservice-starter</artifactId>
                <version>${demo.version}</version>
            </dependency>

            <dependency>
                <groupId>com.kevin</groupId>
                <artifactId>demo-client-starter</artifactId>
                <version>${demo.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
