<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- file-appender.xml中使用了${LOG_FILE}变量，当这个变量未定义时，就会生成一个名为LOG_FILE_IS_UNDEFINED 的文件，此处添加LOG_FILE映射并设置默认值解决此问题-->
    <springProperty scope="context" name="LOG_FILE" source="logging.file.name" defaultValue="logs/application.log"/>

    <!-- 使用 springProperty 直接读取 application.yml -->
    <springProperty scope="context" name="LOGGING_KAFKA_BOOTSTRAP_SERVERS" source="logging.kafka.bootstrap-servers" defaultValue="localhost:9092"/>
    <springProperty scope="context" name="LOGGING_KAFKA_TOPIC" source="logging.kafka.topic" defaultValue="app-logs"/>
    <springProperty scope="context" name="application-name" source="spring.application.name"/>

    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <include resource="org/springframework/boot/logging/logback/file-appender.xml"/>

    <!-- 通过 Kafka 发送日志的 Appender（自定义实现，兼容 Java 21） -->
    <appender name="KAFKA" class="com.kevin.demo.microservice.starter.logging.KafkaAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>${LOGSTASH_LEVEL:-INFO}</level>
        </filter>
        <bootstrapServers>${LOGGING_KAFKA_BOOTSTRAP_SERVERS}</bootstrapServers>
        <topic>${LOGGING_KAFKA_TOPIC}</topic>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <mdc/>
                <context/>
                <logLevel/>
                <loggerName/>
                <pattern>
                    <pattern>
                        {
                        "service": "${application-name:-}"
                        }
                    </pattern>
                </pattern>
                <threadName/>
                <message/>
                <logstashMarkers/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="KAFKA" />
    </root>

</configuration>